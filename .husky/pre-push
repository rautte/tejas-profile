#!/usr/bin/env bash
# .husky/pre-push

set -euo pipefail


REPO_ROOT="$(
  git rev-parse --show-toplevel
)"

cd "${REPO_ROOT}"


echo ""
echo "Pre-push validation"
echo "-------------------"
echo ""


# Local working-tree hygiene only.
#
# Deployment eligibility is determined by:
#
#   CI Quality Gate
#
# after the push.
#
# This hook must never:
#
#   - authenticate to AWS
#   - upload assets
#   - invalidate CloudFront
#   - deploy infrastructure
#   - publish snapshots

git diff \
  --check


echo "✅ Local diff validation passed."
echo ""
echo "ℹ️  GitHub CI will run the authoritative quality gate."
echo ""